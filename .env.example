# Optional compatible MapLibre style URL. Defaults to OpenFreeMap Liberty.
VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# Geocoding and search provider ('photon' or 'nominatim'). Defaults to photon.
VITE_GEOCODING_PROVIDER=photon
VITE_GEOCODING_API_URL=https://photon.komoot.io

# Routing engine provider ('auto', 'osrm', or 'valhalla'). Defaults to auto.
# 'auto' uses OSRM for driving and Valhalla for walking/cycling.
VITE_ROUTING_PROVIDER=auto
VITE_ROUTING_API_URL=https://router.project-osrm.org
VITE_VALHALLA_API_URL=https://valhalla1.openstreetmap.de
